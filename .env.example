# SEIZ Disinformation Trajectory Simulator - Environment Configuration
# Copy to `.env` and customize secrets before deploying to production.

# --- FastAPI Security ---
SEIZ_API_KEY=seiz-secret-api-key
# Optional comma-separated list of additional valid API keys:
# SEIZ_API_KEYS=analyst-key-1,researcher-key-2

# --- PostgreSQL (Async SQLAlchemy & Alembic) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=seiz_tracker
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seiz_tracker

# --- Redis (Rate Limiter, Celery Broker & Result Backend) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to true to execute Celery tasks inline without a broker during local dev:
# CELERY_TASK_ALWAYS_EAGER=true

# --- Streamlit Dashboard ---
SEIZ_API_URL=http://127.0.0.1:8000

# --- InfluxDB v2 & Live Social Ingestion Daemon ---
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=seiz-dev-token
INFLUXDB_ORG=seiz-org
INFLUXDB_BUCKET=seiz_metrics
SEIZ_SOCIAL_API_URL=http://127.0.0.1:8088/mock/posts
